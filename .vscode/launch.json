{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI 后端（8000 热重载）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python3",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "pytest 当前文件",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python3",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "调脚本（示例：moat_narrative.py）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/moat_narrative.py",
      "args": ["600519"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python3",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
